# ========================================================
# Variables de Entorno - Sistema Nube Segura (CENAM)
# ========================================================

# Conexión a Base de Datos PostgreSQL en la Nube (Supabase / Neon / Cloud SQL)
# Formato: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Llave secreta para cifrado y sesiones JWT
SECRET_KEY=cenam_super_secret_key_2026_change_in_production

# Puerto para Google Cloud Run (lo asigna automáticamente Cloud Run en $PORT, por defecto 8080)
PORT=8080

# Nivel de seguridad del entorno (development / production)
ENVIRONMENT=production
